# MedHallu / MedHAM Evaluation - environment variables
#
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# Never commit .env. It is ignored by .gitignore.
#
# Step requirements:
#   schema.py   - no API keys required
#   pipeline.py - OPENAI_API_KEY, ANTHROPIC_API_KEY, GOOGLE_API_KEY, GROQ_API_KEY
#   labeler.py  - OPENAI_API_KEY, ANTHROPIC_API_KEY, GOOGLE_API_KEY,
#                 DEEPSEEK_API_KEY, PUBMED_EMAIL, CROSSREF_MAILTO
#                 plus optional NCBI_API_KEY and HF_TOKEN

# LLM API keys

# GPT-4o - tested model and judge panel
# Get key: https://platform.openai.com
OPENAI_API_KEY=

# Claude Sonnet 4.6 - tested model and judge panel
# Get key: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Gemini 2.5 Flash - tested model and judge panel
# Get key: https://aistudio.google.com
GOOGLE_API_KEY=

# Llama 3.1 8B via Groq - tested model in pipeline.py
# Get key: https://console.groq.com
GROQ_API_KEY=

# DeepSeek V4 Flash - judge panel, claim extraction, and PubMed-FActScore
# Get key: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Citation verification

# PubMed and CrossRef request a contact email for rate-limit auditing.
# Use a valid contact email; it is sent with API requests and not stored.
PUBMED_EMAIL=your.email@example.com
CROSSREF_MAILTO=your.email@example.com

# Optional NCBI API key.
# Without a key: 3 requests/second. With a key: 10 requests/second.
# Free registration: https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# Hugging Face

# Optional. Only needed if the source dataset is gated or if upload scripts are used.
# Generate a read-only or write-scoped token at: https://huggingface.co/settings/tokens
HF_TOKEN=
